# Data mode for the Default Environment Viewer.
#   mock (default) - uses static demo data from src/services/mockData.ts.
#                    Safe to run anywhere, no Power Platform connection required.
#   live           - reads from the CoE Starter Kit Dataverse tables and the
#                    Office 365 Users connector. Requires running the app as a
#                    Power Apps code app (`pac code run`) and registering live
#                    providers — see README.md > "Connecting to live Power
#                    Platform data".
VITE_DATA_MODE=mock
